{
  "compilerOptions": {
    "allowJs": true,
    "jsx": "react",
    "target": "es2024",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "lib": ["esnext", "dom", "dom.iterable"],
    "removeComments": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "inlineSources": true,
    "outDir": "lib",
    "baseUrl": ".",
    "skipLibCheck": true,
    "paths": {
      "*": ["node_modules/*", "src/global/*"]
    }
  },
  "include": ["src/**/*", "internal_packages/**/*", "spec/**/*", "internal_packages/send-later", "internal_packages_disabled/translation", "internal_packages_disabled/github-contact-card", "internal_packages_disabled/personal-level-indicators", "internal_packages_disabled/send-reminders", "internal_packages_disabled/main-calendar"],
  "exclude": ["spec/spec-runner/jasmine.js"]
}
